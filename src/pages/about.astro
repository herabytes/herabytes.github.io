---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, avatarUrl } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="About" description={`About ${site.name}`}>
  <div class="about-head">
    <img src={avatarUrl()} alt={`${site.name}`} width="104" height="104" />
    <h1>{site.name}</h1>
  </div>

  <!-- Author your bio here (or delete this page and keep everything on the landing). -->
  <div class="bio-slot">
    <span class="mono">// bio</span>
    <span class="blank" />
    <span class="blank" />
    <span class="blank short" />
  </div>

  <p class="links">
    <a href={`${base}/`}>← the running inference</a>
  </p>
</BaseLayout>

<style>
  .about-head {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  .about-head img {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    filter: grayscale(0.15) contrast(1.02);
  }
  .bio-slot {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 560px;
  }
  .blank {
    display: block;
    height: 1.2rem;
    width: 100%;
    border-bottom: 1.5px dashed var(--ink-faint);
  }
  .blank.short {
    width: 55%;
  }
  .links {
    font-family: var(--sans);
    font-size: 0.95rem;
  }
  .links a {
    color: var(--blue);
  }
</style>
