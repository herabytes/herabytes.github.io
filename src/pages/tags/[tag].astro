---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getPosts, getAllTags, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  const posts = await getPosts();
  return tags.map(({ tag }) => ({
    params: { tag: tag.toLowerCase() },
    props: {
      tag,
      posts: posts.filter((p) =>
        p.data.tags.some((t) => t.toLowerCase() === tag.toLowerCase())
      ),
    },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <a class="back-link" href={`${base}/tags`}>← All tags</a>
  <h1 style="margin-top:1rem">
    Posts tagged <span class="tag">#{tag}</span>
  </h1>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li>
          <h3>
            <a href={`${base}/blog/${p.id}`}>{p.data.title}</a>
          </h3>
          <div class="post-meta">{formatDate(p.data.date)}</div>
          {p.data.description && <p>{p.data.description}</p>}
          <div class="tag-row">
            {p.data.tags.map((t) => (
              <TagBadge tag={t} />
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
