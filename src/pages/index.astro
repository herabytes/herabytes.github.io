---
import BaseLayout from '../layouts/BaseLayout.astro';
import InferenceBody from '../components/InferenceBody.astro';

const toc = [
  { id: 'intro', label: 'Introduction' },
  { id: 'jspace', n: 1, label: 'J-space' },
  { id: 'cot', n: 2, label: 'Chain of thought samples' },
  { id: 'training', n: 3, label: 'Training data' },
  { id: 'objectives', n: 4, label: 'Objective functions' },
  { id: 'log', n: 5, label: 'Research log' },
  { id: 'rlhf', n: 6, label: 'RLHF' },
];
---

<BaseLayout wide>
  <div class="paperwrap">
    <aside class="sidebar">
      <div class="side-inner">
        <p class="side-label mono">contents</p>
        <nav class="side-nav">
          {toc.map((s) => (
            <a href={`#${s.id}`}>
              {s.n && <span class="secnum">{s.n}</span>}{s.label}
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <div class="content">
      <InferenceBody />
    </div>
  </div>
</BaseLayout>

<style>
  .paperwrap {
    display: grid;
    grid-template-columns: 200px minmax(0, 660px);
    gap: 3.25rem;
    max-width: 920px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .side-inner {
    position: sticky;
    top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .side-label {
    color: var(--ink-faint);
    margin: 0;
    letter-spacing: 0.06em;
  }
  .side-nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border-left: 1px solid var(--rule-strong);
    padding-left: 0.9rem;
  }
  .side-nav a {
    font-family: var(--sans);
    font-size: 0.86rem;
    color: var(--ink-soft);
    text-decoration: none;
    line-height: 1.3;
  }
  .side-nav a:hover {
    color: var(--blue);
  }
  .side-nav .secnum {
    font-family: var(--mono);
    color: var(--mark);
    font-size: 0.78em;
    margin-right: 0.35rem;
  }
  @media (max-width: 820px) {
    .paperwrap {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      max-width: 680px;
    }
    .sidebar {
      display: none;
    }
  }
</style>
