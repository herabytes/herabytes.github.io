---
import { site } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = (base + href).replace(/\/$/, '') || '/';
  if (href === '/') return path === (base || '/') || path === '/';
  return path === target || path.startsWith(target + '/');
};
const link = (href: string) => `${base}${href}`;
---

<nav class="site-nav">
  <div class="container">
    <a class="brand" href={link('/')}>{site.name}</a>
    <div class="links">
      <a href={link('/')} aria-current={isActive('/') ? 'page' : undefined}>Home</a>
      <a href={link('/about')} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
      <a href={link('/blog')} aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
    </div>
  </div>
</nav>
