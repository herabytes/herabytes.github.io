---
import { site } from '../config';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="container">
    <span>© {year} {site.name}</span>
    <nav class="foot-links">
      <a href={`${base}/`}>Home</a>
      <a href={`${base}/blog`}>Blog</a>
    </nav>
    <div class="socials">
      <a href={site.social.github} target="_blank" rel="me noopener">GitHub</a>
      <a href={site.social.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
      <a href={site.social.x} target="_blank" rel="me noopener">X</a>
    </div>
  </div>
</footer>
